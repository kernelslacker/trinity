	MISSING_DEFS=1
else
	echo $GREEN "[YES]" $COL_RESET
	echo "#define USE_BPF_PROG_STREAM_READ 1" >> $CONFIGH
fi

#############################################################################################
# Does linux/bpf.h give union bpf_attr the prog_stream_open member
# (BPF_PROG_STREAM_OPEN, added in 7.4)
#
echo -n "[*] Checking if bpf_attr has prog_stream_open.. "
