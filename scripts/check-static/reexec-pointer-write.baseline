# reexec-pointer-write.baseline
#
# REEXEC_SANITISE_OK entries whose sanitiser stores a pointer into rec->aN
# itself (an allocator result or an address-of), listed so a new one is a
# conscious choice.  Each pointer is fresh per replay: the re-exec runs
# generate_syscall_args() in full and the inner dispatch_step owns the
# result (include/syscall.h, above REEXEC_SANITISE_OK).
#
# This list only shrinks.  A line fails once its entry stops matching.

syscalls/aio/io_cancel.c:syscall_io_cancel
syscalls/aio/io_getevents.c:syscall_io_getevents
syscalls/aio/io_pgetevents.c:syscall_io_pgetevents
syscalls/aio/io_setup.c:syscall_io_setup
syscalls/aio/io_submit.c:syscall_io_submit
