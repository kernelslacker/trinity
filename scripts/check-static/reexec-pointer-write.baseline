syscalls/concurrency/futex_wait.c:syscall_futex_wait
syscalls/concurrency/futex_waitv.c:syscall_futex_waitv
syscalls/concurrency/rseq.c:syscall_rseq
syscalls/cred/capget.c:syscall_capget
syscalls/cred/capset.c:syscall_capset
syscalls/cred/setgroups.c:syscall_setgroups
syscalls/fs/mount/listmount.c:syscall_listmount
