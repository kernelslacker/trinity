# check-json-sub-completeness.baseline
#
# Pre-existing scalar fields that have a stat_category JSON descriptor for their
# parent struct but are not yet listed in the descriptor table.  These existed
# before the gate was introduced by t489.  Add a wire-up commit and remove the
# entry here; do NOT add new entries without also filing a follow-up task.
#
# Format: MISSING:<sub>.<field>   # brief reason
#
MISSING:af_alg_probe.done              # not yet wired to af_alg_probe descriptor table
MISSING:childop.walltime_ns            # internal per-child wall-time accumulator; not yet JSON-wired
MISSING:childop.fd_probe_calls         # fd-probe diagnostic; not yet JSON-wired
MISSING:childop.fd_probe_ns_total      # fd-probe timing accumulator; not yet JSON-wired
MISSING:childop.direct_tally_dropped   # drop-counter for out-of-range ops; surfaced via counter-rates periodic stream, not main JSON blob
MISSING:childop.decay_slot             # bandit slot bookkeeping; not yet JSON-wired
MISSING:ebpf_gen.map_fd_substituted    # ebpf_gen field; not yet wired to bpf_fd_provider descriptor
MISSING:ebpf_gen.helper_call_emitted   # ebpf_gen field; not yet wired
MISSING:ebpf_gen.map_value_deref_emitted # ebpf_gen field; not yet wired
MISSING:ebpf_gen.map_value_deref_read  # ebpf_gen field; not yet wired
MISSING:ebpf_gen.map_value_deref_write # ebpf_gen field; not yet wired
