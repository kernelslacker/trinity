# stats-periodic-jsonl-schema.baseline
#
# Field names for the periodic JSONL surfaces emitted by
# stats/log.c (stats_timeseries_emit_window) and the terminal
# record written by stats_timeseries_close().
#
# Two sections:
#   [terminal]  -- fields in the shutdown terminal record
#   [window]    -- fields in a periodic window record
#                  (only present when >= 10001 ops were run)
#
# Regenerate after a field-name change with:
#   scripts/check-static/check-runtime-json-output.sh --regen
# and commit the diff alongside the code change.

[terminal]
cross_check_ok
last_window_op_count
total_ops
type

[window]
by_childop
by_strategy
cmp_hint_wins
cmp_hint_wins_delta
cmp_hints_consumed
cmp_hints_consumed_delta
cmp_hints_injected
cmp_hints_injected_delta
cmp_hyp_consumed
cmp_hyp_consumed_delta
cmp_hyp_live_injected
cmp_hyp_live_injected_delta
cmp_hyp_pc_wins
cmp_hyp_pc_wins_delta
cmp_trace_truncated
cmp_trace_truncated_delta
distinct_edges_warm_loaded
edges_found_gained
edges_found_run_gained
edges_found_total
edges_gained_this_window
edges_run_gained
edges_total
edges_warm_loaded
enter_thresh
exit_thresh
hard_stall_active
intervention_active
per_syscall
plateau_hypothesis
plateau_intervention_mode
plateau_last_window_delta
plateau_window_elapsed
soft_sat
t
trace_loss
trace_loss_delta
trace_truncated
trace_truncated_delta
window_sec

