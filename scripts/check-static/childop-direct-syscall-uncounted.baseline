# Grandfathered childop files that issue raw syscalls without a complete
# childop_direct_syscalls_add() accounting chain.
#
# Two categories:
#
# UNCOUNTED — file-level: the translation unit calls raw-syscall functions
# (trinity_raw_syscall(), socket(), sendmsg(), sendto(), setsockopt(),
# mmap(), syscall()) but does not call childop_direct_syscalls_add().
# Many of these route netlink-path syscalls through the nl_* transport
# which calls childop_direct_syscalls_add() internally at nl_close(); own-
# body calls outside that transport remain uncounted.
#
# THREAD_UNCOUNTED — worker-thread level: the file IS wired at the op-body
# level (calls childop_direct_syscalls_add()) but contains a static void *
# pthread worker function that issues raw syscalls without accumulating them
# back into the parent's direct_calls tally.
#
# The UNCOUNTED list should shrink over time as each file is wired.
# THREAD_UNCOUNTED entries should be fixed by adding a tally field to the
# thread arg struct, accumulating in the worker, and folding after join.
# Never grow either list.
childops/fs/hfs-mount-fuzz.c
childops/misc/close-racer.c
childops/net/bareudp-rx.c
childops/net/bridge-fdb-stp-traffic.c
childops/net/bridge-fdb-stp-vlan-mass.c
childops/net/esp-crafted-rx-frag.c
childops/net/esp-crafted-rx-stacked.c
childops/net/geneve-rx.c
childops/net/ip_gre-churn.c
childops/net/ipv6-pmtu-teardown-race.c
childops/net/l2tp-ifname-race.c
childops/net/netfilter/nfnl-util.c
childops/net/netfilter/nftables/churn.c
childops/net/netfilter/nftables/fwd.c
childops/net/netfilter/nftables/l4frag.c
childops/net/netlink/genl-util.c
childops/net/netlink/nl80211-churn-discovery.c
childops/net/psp-key-rotate-devlink-port.c
childops/net/psp-key-rotate-lifecycle.c
childops/net/sctp-chunk-rx.c
childops/net/veth-asymmetric-xdp.c
childops/net/vrf-fib-churn.c
childops/net/xfrm/xfrm-churn-compat-sweep.c
childops/net/xfrm/xfrm-churn-pfkey.c
childops/net/xfrm/xfrm-churn-traffic.c
