# Grandfathered childop files that issue raw syscalls without a complete
# childop_direct_syscalls_add() accounting chain.
#
# Two namespaced categories:
#
# UNCOUNTED:<file> — file-level: the translation unit calls raw-syscall
# functions (trinity_raw_syscall(), socket(), sendmsg(), sendto(),
# setsockopt(), mmap(), syscall()) but does not call
# childop_direct_syscalls_add().  Many of these route netlink-path
# syscalls through the nl_* transport which calls
# childop_direct_syscalls_add() internally at nl_close(); own-body calls
# outside that transport remain uncounted.
#
# THREAD_UNCOUNTED:<file>#<fn> — worker-thread level: the file IS wired at
# the op-body level (calls childop_direct_syscalls_add()) but contains a
# static void * pthread worker function <fn> that issues raw syscalls
# without accumulating them back into the parent's direct_calls tally.
# Each worker gets its own baseline slot so that new workers added to an
# already-baselined file are caught immediately.
#
# FORK_UNCOUNTED:<file>#<fn> — fork-worker level: the file IS wired but
# contains a static void fork-child body <fn> (detected by presence of
# _exit() without an internal fork() call) that issues raw syscalls
# without a ->syscall/tally/count accumulation visible to the scanner.
# Like THREAD_UNCOUNTED, each worker gets its own slot.  Fix by adding
# a shared-memory tally (shm is MAP_SHARED) or by wiring the worker
# to call childop_direct_syscalls_add() before _exit().
#
# The UNCOUNTED list should shrink over time as each file is wired.
# THREAD_UNCOUNTED and FORK_UNCOUNTED entries should be fixed by proper
# per-worker tally wiring.  Never grow any of these lists.
UNCOUNTED:childops/fs/hfs-mount-fuzz.c
UNCOUNTED:childops/net/bareudp-rx.c
UNCOUNTED:childops/net/bridge-fdb-stp-traffic.c
UNCOUNTED:childops/net/bridge-fdb-stp-vlan-mass.c
UNCOUNTED:childops/net/esp-crafted-rx-frag.c
UNCOUNTED:childops/net/esp-crafted-rx-stacked.c
UNCOUNTED:childops/net/geneve-rx.c
UNCOUNTED:childops/net/ip_gre-churn.c
UNCOUNTED:childops/net/netfilter/nfnl-util.c
UNCOUNTED:childops/net/netfilter/nftables/fwd.c
UNCOUNTED:childops/net/netfilter/nftables/l4frag.c
UNCOUNTED:childops/net/netlink/genl-util.c
UNCOUNTED:childops/net/netlink/nl80211-churn-discovery.c
UNCOUNTED:childops/net/psp-key-rotate-devlink-port.c
UNCOUNTED:childops/net/psp-key-rotate-lifecycle.c
UNCOUNTED:childops/net/sctp-chunk-rx.c
UNCOUNTED:childops/net/veth-asymmetric-xdp.c
UNCOUNTED:childops/net/xfrm/xfrm-churn-compat-sweep.c
UNCOUNTED:childops/net/xfrm/xfrm-churn-pfkey.c
UNCOUNTED:childops/net/xfrm/xfrm-churn-traffic.c
THREAD_UNCOUNTED:childops/misc/close-racer.c#racer_thread
THREAD_UNCOUNTED:childops/recipe/close-race.c#timerfd_xclose_racer_thread
THREAD_UNCOUNTED:childops/recipe/deadline-race.c#bpf_htab_racer_thread
THREAD_UNCOUNTED:childops/recipe/deadline-race.c#perf_mmap_close_racer_thread
THREAD_UNCOUNTED:childops/recipe/deadline-race.c#keys_revoke_racer_thread
THREAD_UNCOUNTED:childops/misc/cgroup-churn.c#psi_writer
THREAD_UNCOUNTED:childops/net/bridge-conntrack-churn.c#brct_packet_sender
THREAD_UNCOUNTED:childops/recipe/net.c#tcp_racer_thread
FORK_UNCOUNTED:childops/net/espintcp-coalesce-churn.c#noing_helper # fork-child body; syscalls via bump_direct wrapper but not visible to scanner
FORK_UNCOUNTED:childops/recipe/supervisor.c#cgroup_kill_inner # open+write+close+prctl before _exit; parent accounts separately
FORK_UNCOUNTED:childops/recipe/supervisor.c#seccomp_listener_inner # trinity_raw_syscall(__NR_uname) before _exit; parent accounts separately
# Newly surfaced by extended fork-worker detection (t439): these workers use
# __attribute__((noreturn)) on the same line as the static void signature, or
# terminate via syscall(__NR_exit) rather than bare _exit(), making them
# invisible to the previous _exit()-only predicate. All files are wired at
# the op-body level; the fork-child raw-syscall budget is not yet propagated
# back into the parent's direct_calls tally. Wiring is a separate concern.
FORK_UNCOUNTED:childops/fs/statmount-idmap-overflow.c#carrier_child # static __attribute__((noreturn)) void (noreturn+static on same line); socket/setsockopt in carrier userns setup; parent tally wiring needed
FORK_UNCOUNTED:childops/misc/sysv-shm-orphan-race.c#sysv_shm_originator_main # noreturn preceding line + syscall(__NR_exit,0); SysV shm orphan race loop; parent tally wiring needed
FORK_UNCOUNTED:childops/misc/sysv-shm-orphan-race.c#sysv_shm_attacher_main # noreturn preceding line + syscall(__NR_exit,0); SysV shm attach race loop; parent tally wiring needed
FORK_UNCOUNTED:childops/net/af-unix-peek-race.c#af_unix_peek_sibling_main # noreturn preceding line + syscall(__NR_exit,0); AF_UNIX peek-race sibling; parent tally wiring needed
FORK_UNCOUNTED:childops/net/af-unix-scm-rights-gc.c#af_unix_sibling_main # motivating case for this commit: noreturn preceding line + syscall(__NR_exit,0); AF_UNIX gc-race sibling; parent tally wiring needed
FORK_UNCOUNTED:childops/net/inet-listener-rehash-race.c#twseed_worker # static __attribute__((noreturn)) void (same line); _exit(); inet listener rehash tw-seed worker; parent tally wiring needed
FORK_UNCOUNTED:childops/net/inet-listener-rehash-race.c#churn_worker # static __attribute__((noreturn)) void (same line); _exit(); inet listener rehash churn worker; parent tally wiring needed
FORK_UNCOUNTED:childops/net/inet-listener-rehash-race.c#syn_worker # static __attribute__((noreturn)) void (same line); _exit(); inet listener rehash syn worker; parent tally wiring needed
FORK_UNCOUNTED:childops/net/inet-listener-rehash-race.c#rehash_worker # static __attribute__((noreturn)) void (same line); _exit(); inet listener rehash worker; parent tally wiring needed
FORK_UNCOUNTED:childops/net/qrtr-bind-race.c#qrtr_bind_child # static __attribute__((noreturn)) void (same line); _exit(); QRTR bind-race fork child; parent tally wiring needed
FORK_UNCOUNTED:childops/net/xfrm/pfkey-spd-walk.c#spd_walker_child # static __attribute__((noreturn)) void (same line); _exit(); PF_KEY SPD walker fork child; parent tally wiring needed
FORK_UNCOUNTED:childops/net/xfrm/pfkey-spd-walk.c#spd_racer_child # static __attribute__((noreturn)) void (same line); _exit(); PF_KEY SPD racer fork child; parent tally wiring needed
