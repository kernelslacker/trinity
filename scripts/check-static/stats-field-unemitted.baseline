# stats-field-unemitted.baseline
#
# Fields in stats/subsys/*.h that are intentionally NOT wired to any
# JSON emitter.  Each line names a field that is legitimate internal
# bookkeeping -- not a counter an external operator or scraper needs
# to see -- and explains why it lives outside the emission path.
#
# Format: UNEMITTED:<header>:<field>  # <reason>
#
# Do NOT add fields here to silence a noisy census without a clear
# reason.  A field with a non-zero live producer that is useful to
# operators belongs in an emitter, not this file.  Only window-start
# snapshots, forward-carved reservations, and pure-internal scheduling
# state belong here.

# Forward-carved reservation: no live producer; comment in the header
# explicitly marks it as a placeholder for a future ftrace-subset
# dispatcher.  The slot is present so that dispatcher can land without
# needing a separate struct change.
UNEMITTED:stats/subsys/tracefs_fuzzer.h:ftrace_subset_skipped

# Internal bandit window-start snapshots.  Both fields are written with
# __atomic_store_n (not incremented) at each strategy rotation to record
# the per-arm count and call count at the start of the window.  They are
# read by bandit_record_pull() to compute per-window deltas; they are not
# monotonic counters and carry no independent value for external reports.
UNEMITTED:stats/subsys/transition_edge.h:count_at_window_start
UNEMITTED:stats/subsys/transition_edge.h:calls_at_window_start

# Internal snapshot timestamp.  Written with __atomic_store_n to record
# the wall-clock second of the last minicorpus snapshot and read back
# to enforce the minimum inter-snapshot interval.  An operator comparing
# two consecutive --stats-json dumps would see the same value within a
# snapshot window, making it misleading as a rate counter.  The corpus
# activity metrics (mut_trials, mut_wins, xprop_*) in the minicorpus
# section are the actionable observables.
UNEMITTED:stats/subsys/minicorpus.h:last_snapshot_time
