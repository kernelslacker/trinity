# stats-field-unemitted.baseline
#
# Fields in stats/subsys/*.h that are intentionally NOT wired to any
# JSON emitter.  Each line names a field that is legitimate internal
# bookkeeping -- not a counter an external operator or scraper needs
# to see -- and explains why it lives outside the emission path.
#
# Format: UNEMITTED:<header>:<field>  # <reason>
#
# Do NOT add fields here to silence a noisy census without a clear
# reason.  A field with a non-zero live producer that is useful to
# operators belongs in an emitter, not this file.  Only window-start
# snapshots, forward-carved reservations, and pure-internal scheduling
# state belong here.

# Forward-carved reservation: no live producer; comment in the header
# explicitly marks it as a placeholder for a future ftrace-subset
# dispatcher.  The slot is present so that dispatcher can land without
# needing a separate struct change.
UNEMITTED:stats/subsys/tracefs_fuzzer.h:ftrace_subset_skipped

# Internal bandit window-start snapshots.  Both fields are written with
# __atomic_store_n (not incremented) at each strategy rotation to record
# the per-arm count and call count at the start of the window.  They are
# read by bandit_record_pull() to compute per-window deltas; they are not
# monotonic counters and carry no independent value for external reports.
UNEMITTED:stats/subsys/transition_edge.h:count_at_window_start
UNEMITTED:stats/subsys/transition_edge.h:calls_at_window_start

# Internal snapshot timestamp.  Written with __atomic_store_n to record
# the wall-clock second of the last minicorpus snapshot and read back
# to enforce the minimum inter-snapshot interval.  An operator comparing
# two consecutive --stats-json dumps would see the same value within a
# snapshot window, making it misleading as a rate counter.  The corpus
# activity metrics (mut_trials, mut_wins, xprop_*) in the minicorpus
# section are the actionable observables.
UNEMITTED:stats/subsys/minicorpus.h:last_snapshot_time

# Fleet-election CAS latch: 0 -> 1 compare-exchange, not a counter.
# Lives in stats struct so it shares the shm mapping and survives
# across childdata recycles, but carries no per-call metric value.
# The actionable signal is the runs / accept_total / reject_total
# counters in the same struct, which are wired to the JSON emitter.
UNEMITTED:stats/subsys/af_alg_probe.h:done

# Adaptive-budget internal scheduler state.  budget_mult[] holds a
# Q8.8 fixed-point multiplier per op type (256 == 1.0x) consumed by
# the BUDGETED() macro inside opt-in childops; it is updated by
# adapt_budget() after each dispatch and clamps to [MIN, MAX].
# zero_streak[] counts consecutive invocations that did not clear the
# edge threshold, resetting on the first productive invocation.  Both
# arrays drive the inner-loop iteration count but carry no per-window
# diagnostic value visible to an operator.
UNEMITTED:stats/subsys/childop.h:budget_mult
UNEMITTED:stats/subsys/childop.h:zero_streak

# Per-op direct-syscall accumulator.  Filled by opt-in childops via
# childop_direct_syscalls_add(); ops that do not opt in leave their
# slot at zero.  The array is read by childop_outcome_snapshot() and
# written to the per-op outcome struct, but the outcome struct itself
# is not yet plumbed through a stats/ emitter.
UNEMITTED:stats/subsys/childop.h:direct_syscalls

# Per-op SIGALRM-timeout counters.  timeout_observed[op] bumps when
# the watchdog alarm fired before the op returned; timeout_missed[op]
# bumps when the op returned before the alarm fired.  Both populate
# struct childop_outcome's slots but the outcome struct is not yet
# plumbed through a stats/ emitter.
UNEMITTED:stats/subsys/childop.h:timeout_observed
UNEMITTED:stats/subsys/childop.h:timeout_missed

# Per-op decaying edge+wall recency ring (NR_CHILD_OP_TYPES x
# CHILDOP_DECAY_WINDOWS 2-D arrays).  Written by child-altop-budget.c
# and rotated by childop_window_advance().  The CACHED running sums
# (edge_recent_cached[], wall_recent_cached[]) ARE read by
# dump_stats_childop_decay_recency() and wired to the shutdown text
# dump, but the raw history ring arrays are not themselves emitted --
# only the derived cached sums surface to operators.  Too wide for
# flat JSON (NR_CHILD_OP_TYPES x CHILDOP_DECAY_WINDOWS entries each).
UNEMITTED:stats/subsys/childop.h:edge_history
UNEMITTED:stats/subsys/childop.h:wall_history

# Per-syscall compare-exchange slot for the shadow errno-class gradient
# predicate.  Stores the last observed gradient class (0/1/2) per
# syscall nr; updated via CAS so only strictly-greater observations
# win.  The comment in the header explicitly marks it as "NOT rendered,
# INTERNAL to the gradient predicate."  The actionable counters
# (crossings, to_permstate, to_success) are wired to the descriptor
# table and emitted normally.
UNEMITTED:stats/subsys/errno_gradient.h:last_class

# SHADOW-ONLY per-syscall arrays in struct frontier_per_syscall_stats.
# All three arrays are MAX_NR_SYSCALL slots wide -- too wide for the
# flat JSON schema.  silent_streak_per_syscall[] carries the current
# run-length of consecutive silent-regime picks per syscall since the
# last productive-edge event.  silent_cmp_baseline[] and
# silent_errno_success_baseline[] are per-syscall snapshots taken at
# each streak reset so the picker can detect CMP or errno novelty
# without a new collection path.  No live picker path reads them;
# they are observability-only signals surfaced via the periodic dump's
# top-N attribution path, not the JSON schema.
UNEMITTED:stats/subsys/frontier.h:silent_streak_per_syscall
UNEMITTED:stats/subsys/frontier.h:silent_cmp_baseline
UNEMITTED:stats/subsys/frontier.h:silent_errno_success_baseline

# SHADOW-ONLY per-syscall miss-streak array (MAX_NR_SYSCALL slots).
# Carries the run-length of consecutive zero-edge LIVE-regime picks
# per syscall.  Same shape and exclusion rationale as the silent-streak
# sibling above: too wide for flat JSON, surfaced via the periodic
# dump's top-N attribution only.
UNEMITTED:stats/subsys/frontier.h:live_miss_streak_per_syscall

# SHADOW-ONLY frseq per-syscall and per-group demote distribution
# arrays.  frseq_would_skip_per_syscall[] is MAX_NR_SYSCALL slots;
# frseq_would_skip_per_group[] is NR_GROUPS slots.  Both are too wide
# for the flat JSON schema (the scalar frseq_would_skip IS emitted).
# Surfaced via the periodic dump's top-N path only.
UNEMITTED:stats/subsys/frontier.h:frseq_would_skip_per_syscall
UNEMITTED:stats/subsys/frontier.h:frseq_would_skip_per_group

# Per-recipe completion counters (MAX_IOURING_RECIPES / MAX_RECIPES
# slots respectively).  Too wide for the flat JSON schema.  The scalar
# completed total in each struct IS emitted; the per-slot breakdown
# lives in the periodic dump's top-N path only.
UNEMITTED:stats/subsys/iouring_recipes.h:completed_per
UNEMITTED:stats/subsys/recipe.h:completed_per

# Per-syscall errno-sourced corpus accounting (MAX_NR_SYSCALL arrays).
# errno_saves[nr] counts corpus admits tagged CORPUS_SAVE_REASON_ERRNO
# for syscall nr; errno_pcedge_wins[nr] counts PC-edge conversions from
# errno-sourced replays.  Both are observability-only signals, not yet
# wired to a dump path; too wide for flat JSON.
UNEMITTED:stats/subsys/pc_edge_source.h:errno_saves
UNEMITTED:stats/subsys/pc_edge_source.h:errno_pcedge_wins

# Per-strategy transition accounting (NR_STRATEGIES arrays).  Both are
# bandit reward inputs: calls_by_strategy[] and count_by_strategy[] are
# read by bandit_record_pull() to compute per-window transition deltas.
# Unlike the analogous pc_edge_count_at_window_start (in shm_s), these
# NR_STRATEGIES-wide arrays are not yet wired to any dump emitter.
UNEMITTED:stats/subsys/transition_edge.h:calls_by_strategy
UNEMITTED:stats/subsys/transition_edge.h:count_by_strategy

# ── Population B: struct stats_s fields in include/stats.h ───────────────────
#
# These fields are members of struct stats_s declared in include/stats.h.
# The emission requirement for Population B is stricter than for Population A:
# a field must appear in stats/json/*.c (JSON export).  A reference in the
# text-dump path (stats/dump/) is not sufficient.
#
# The entries below reflect the state at the time Population B was added to
# this gate.  They are seeded from the real delta -- not grandfathered
# blindly -- so that each entry carries an explicit reason.  The baseline
# should shrink as fields are wired to stats/json/*.c emitters.
#
# Reason codes used below:
#   DUMP-ONLY : referenced in a stats/dump/ text emitter but absent from
#               stats/json/*.c; the JSON-export gap this gate was added to catch.
#   DARK      : no reference in any stats/ .c file at all; the field is
#               written by a producer outside stats/ but has no consumer.

# post_handler_untouched_out_buf: DARK.  Written by the post-handler sanity
# check in a post handler TU; no stats/ emitter reads it yet.
UNEMITTED:include/stats.h:post_handler_untouched_out_buf

# genl_family_calls_* dispatch counters: DARK (no stats/ .c reference).
# 20 of the 23 family counters are wired via STAT_FIELD(genl_family_calls, X)
# in stats/json/core.c and are therefore emitted to JSON; those are no longer
# in this baseline.  ncsi, tcmu, and nfsd have no STAT_FIELD entry in any
# stats/json/ file and no direct member access -- they may lack a reachable
# producer on the test system.
UNEMITTED:include/stats.h:genl_family_calls_ncsi
UNEMITTED:include/stats.h:genl_family_calls_tcmu
UNEMITTED:include/stats.h:genl_family_calls_nfsd

# watchdog_signal: DARK.  No reference found in any stats/ .c file; the field
# may be bumped from outside stats/ (watchdog TU) but has no emitter at all.
UNEMITTED:include/stats.h:watchdog_signal

# Subsystem scalar aggregates embedded directly in struct stats_s: DUMP-ONLY.
# These fields aggregate per-subsystem scalars and are referenced by the text
# dump (stats/dump/subsystems.c or stats/dump/strategy.c) but are absent from
# the JSON emitters in stats/json/.  Each should be wired to the appropriate
# stats/json/ section (core.c, network.c, or a new subsystem section).
UNEMITTED:include/stats.h:ebpf_gen
UNEMITTED:include/stats.h:zombie_reaper
UNEMITTED:include/stats.h:picker_bandit
UNEMITTED:include/stats.h:cmp_frontier
UNEMITTED:include/stats.h:expensive_adaptive
UNEMITTED:include/stats.h:cost_pool_selector
UNEMITTED:include/stats.h:context_suppress
UNEMITTED:include/stats.h:remote_adaptive
UNEMITTED:include/stats.h:btrfs_ioctls_dispatched
UNEMITTED:include/stats.h:ioctl_group_match
UNEMITTED:include/stats.h:ioctl_group_miss
UNEMITTED:include/stats.h:ioctl_group_random
UNEMITTED:include/stats.h:ip6mr_churn
UNEMITTED:include/stats.h:accept_unblocker
UNEMITTED:include/stats.h:pipe_waker
UNEMITTED:include/stats.h:syscall_dispatch
UNEMITTED:include/stats.h:cred_class

# blob_ab: DARK.  No reference in any stats/ .c file; the subsystem may not
# have a dump consumer yet.
UNEMITTED:include/stats.h:blob_ab
