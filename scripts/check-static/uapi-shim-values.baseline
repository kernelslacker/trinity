# uapi-shim-values.baseline
#
# Cross-check table for uapi-shim-values.sh.
#
# ROLE (new):
#   The gate now harvests every "#define SYM <integer>" across the whole tree,
#   compiles a probe against installed linux uapi headers, and verifies all
#   compiler-resolvable symbols directly.  This file no longer drives the
#   coverage boundary; it is an ADDITIONAL cross-check that specific
#   well-known values haven't changed in the kernel headers.
#
# HOW IT IS USED:
#   For each entry here the gate additionally verifies:
#     (a) the compiler can resolve the symbol (not just a trinity-private name)
#     (b) the compiler's value matches the value recorded here
#   Either mismatch fails the gate.  If the kernel headers ever change one of
#   these, the baseline must be updated to match.
#
# WHY THIS EXISTS:
#   #ifndef guards on enum values are always taken (enums are not macros;
#   cpp #ifndef is unconditionally true for them).  The shim IS the
#   definition, always.  A wrong value here compiles clean, links clean,
#   and silently sends the wrong netlink attribute to the kernel forever.
#
# Format: <SYMBOL> <decimal_value>  [# optional comment]
# One symbol per line; blank lines and #-comments are ignored.
#
# Reference: linux-linus include/uapi/linux/ (compiler-verified 2026-08).
# The whole-tree probe independently confirms these values on every run.

# ---------------------------------------------------------------------------
# IFLA_GRE_* -- linux/if_tunnel.h
#   enum: UNSPEC=0 LINK=1 IFLAGS=2 OFLAGS=3 IKEY=4 OKEY=5 LOCAL=6 REMOTE=7
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# IFLA_IPTUN_* -- linux/if_tunnel.h
#   enum: UNSPEC=0 LINK=1 LOCAL=2 REMOTE=3
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# NDA_* -- linux/neighbour.h
#   enum: UNSPEC=0 DST=1 LLADDR=2 CACHEINFO=3 PROBES=4 VLAN=5 PORT=6
#         VNI=7 IFINDEX=8 MASTER=9 ...
# ---------------------------------------------------------------------------
NDA_DST    1

# ---------------------------------------------------------------------------
# XFRMA_* -- linux/xfrm.h (newer attrs shimmed in net/netlink/msg-tables.c)
#   enum positions verified against linux-linus include/uapi/linux/xfrm.h
#   (commit 053ee9424ae8 corrected these from an off-by-one)
# ---------------------------------------------------------------------------
XFRMA_NAT_KEEPALIVE_INTERVAL  34
XFRMA_SA_PCPU                 35
XFRMA_IPTFS_DROP_TIME         36
XFRMA_IPTFS_REORDER_WINDOW    37
XFRMA_IPTFS_DONT_FRAG         38
XFRMA_IPTFS_INIT_DELAY        39
XFRMA_IPTFS_MAX_QSIZE         40
XFRMA_IPTFS_PKT_SIZE          41

# ---------------------------------------------------------------------------
# NL80211_CMD_* -- include/kernel/nl80211.h
#   Four values corrected by commit 320404245dae; verified against
#   include/uapi/linux/nl80211.h in linux-linus via compiler probe.
# ---------------------------------------------------------------------------
NL80211_CMD_REQ_SET_REG        27
NL80211_CMD_SET_WIPHY_NETNS    49
NL80211_CMD_SET_PMK           123
NL80211_CMD_DEL_PMK           124
