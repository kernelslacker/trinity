childops/net/xfrm/xfrm-churn-traffic.c       # carve of xfrm_churn (dispatch: xfrm-churn.c)

# --- recipe infrastructure ---
# The recipe/ sub-directory contains shared recipe runner infrastructure
# (CHILD_OP_RECIPE_RUNNER / recipe_runner in childops/recipe/runner.c) plus
# individual recipe implementation files.  All write shm->stats.recipe.*
# but the dispatch entry point is runner.c, not the per-recipe files.
childops/recipe/close-race.c    # recipe infrastructure (dispatch: runner.c)
childops/recipe/deadline-race.c # recipe infrastructure (dispatch: runner.c)
childops/recipe/net.c           # recipe infrastructure (dispatch: runner.c)
childops/recipe/simple.c        # recipe infrastructure (dispatch: runner.c)
childops/recipe/simple-fs.c     # recipe infrastructure (dispatch: runner.c)
childops/recipe/simple-mm.c     # recipe infrastructure (dispatch: runner.c)
childops/recipe/supervisor.c    # recipe infrastructure (dispatch: runner.c)
