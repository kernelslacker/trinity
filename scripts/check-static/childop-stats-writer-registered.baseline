# childop-stats-writer-registered.baseline
#
# Files under childops/ that write shm->stats.* but do not themselves
# define a CHILD_OP_* dispatch function.  Each entry is a legitimate
# carve file (called from a sibling's registered dispatch entry point)
# or a shared infrastructure unit.
#
# Format: <relative/path/from/repo/root>  # <reason>
#
# Do NOT add files here to silence the gate without a clear reason.
# A file that writes stats counters but has no caller reachable from
# a registered dispatch entry point is dead code and belongs in a fix,
# not this list.  Only carve files and shared infrastructure belong here.
# The baseline should shrink over time, never grow.
#
# NOTE: childops/net/crafted-icmp-rx.c is intentionally ABSENT.
# It writes shm->stats.icmp_inject.* but has no CHILD_OP_* entry and
# no callers in the tree -- a dead-code registration gap.
# Leave it flagging so the gap is not silently buried.

# --- io_uring recipe carves ---
# These four files implement the iouring_recipes childop (registered as
# CHILD_OP_IOURING_RECIPES / iouring_recipes in childops/io_uring/recipes.c).
# They bump shm->stats.iouring_recipes.* but the dispatch entry point is in
# recipes.c, not in the individual sub-files.
childops/io_uring/recipes-fs.c            # carve of iouring_recipes (dispatch: recipes.c)
childops/io_uring/recipes-net.c           # carve of iouring_recipes (dispatch: recipes.c)
childops/io_uring/recipes-poll-timeout.c  # carve of iouring_recipes (dispatch: recipes.c)
childops/io_uring/recipes-register.c      # carve of iouring_recipes (dispatch: recipes.c)

# --- afxdp_churn carves ---
# Three focused sub-files for CHILD_OP_AFXDP_CHURN (dispatch: afxdp-churn.c).
childops/net/afxdp-churn-attach.c  # carve of afxdp_churn (dispatch: afxdp-churn.c)
childops/net/afxdp-churn-io.c      # carve of afxdp_churn (dispatch: afxdp-churn.c)
childops/net/afxdp-churn-umem.c    # carve of afxdp_churn (dispatch: afxdp-churn.c)

# --- bridge_fdb_stp carves ---
# Four carve files for CHILD_OP_BRIDGE_FDB_STP (dispatch: bridge-fdb-stp.c).
childops/net/bridge-fdb-stp-setup.c      # carve of bridge_fdb_stp (dispatch: bridge-fdb-stp.c); do_bridge_star_g_uaf called from bridge_fdb_stp_in_ns
childops/net/bridge-fdb-stp-stp.c        # carve of bridge_fdb_stp (dispatch: bridge-fdb-stp.c)
childops/net/bridge-fdb-stp-traffic.c    # carve of bridge_fdb_stp (dispatch: bridge-fdb-stp.c)
childops/net/bridge-fdb-stp-vlan-mass.c  # carve of bridge_fdb_stp (dispatch: bridge-fdb-stp.c)

# --- esp_crafted_rx carves ---
# Two carve files for CHILD_OP_ESP_CRAFTED_RX (dispatch: esp-crafted-rx.c).
childops/net/esp-crafted-rx-frag.c     # carve of esp_crafted_rx (dispatch: esp-crafted-rx.c)
childops/net/esp-crafted-rx-stacked.c  # carve of esp_crafted_rx (dispatch: esp-crafted-rx.c)

# --- nftables_churn carves ---
# Six sub-files implementing nftables rule categories for
# CHILD_OP_NFTABLES_CHURN (dispatch: childops/net/netfilter/nftables/churn.c).
childops/net/netfilter/nftables/compat.c   # carve of nftables_churn
childops/net/netfilter/nftables/dormant.c  # carve of nftables_churn
childops/net/netfilter/nftables/fwd.c      # carve of nftables_churn
childops/net/netfilter/nftables/l4frag.c   # carve of nftables_churn
childops/net/netfilter/nftables/reject.c   # carve of nftables_churn
childops/net/netfilter/nftables/xt.c       # carve of nftables_churn

# --- netlink shared infrastructure ---
# netlink-util.c is a shared helper layer consumed by multiple netlink-routed
# childops (nl80211-churn.c, altname-thrash.c, etc.).  Its stats writes are
# executed via the nl_* transport from those registered dispatch functions.
childops/net/netlink/netlink-util.c  # netlink shared infrastructure (consumed by nl_*-routed ops)

