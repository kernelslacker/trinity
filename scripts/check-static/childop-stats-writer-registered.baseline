childops/net/xfrm/nat-t-churn-cleanup.c  # carve of nat_t_churn (dispatch: nat-t-churn.c)
childops/net/xfrm/nat-t-churn-traffic.c  # carve of nat_t_churn (dispatch: nat-t-churn.c)

