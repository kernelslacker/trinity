# Two focused sub-files for CHILD_OP_NL80211_CHURN (dispatch: nl80211-churn.c).
childops/net/netlink/nl80211-churn-iface.c    # carve of nl80211_churn (dispatch: nl80211-churn.c)
childops/net/netlink/nl80211-churn-station.c  # carve of nl80211_churn (dispatch: nl80211-churn.c)

